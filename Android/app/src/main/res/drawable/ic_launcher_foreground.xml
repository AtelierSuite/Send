<?xml version="1.0" encoding="utf-8"?>
<!-- The Send icon from Apple/Wooosh/AppIcon.icon: a file standing in a folder. Same
     paths as the Apple layers, drawn flat: launchers have no glass or blur, so the
     front panel cannot frost the file behind it. Instead the file stops at the panel's
     top edge and a fading glow stands in for the frosted part, and the alphas match
     the Apple render's light appearance. Scaled about the centre so the glyph fills
     the tile as it does on Apple and stays inside the 66dp safe circle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <group
        android:pivotX="512"
        android:pivotY="512"
        android:scaleX="0.76"
        android:scaleY="0.76">
        <path
            android:name="back"
            android:pathData="M288 324H436A36 36 0 0 1 472 360V372H724A48 48 0 0 1 772 420V732A48 48 0 0 1 724 780H300A48 48 0 0 1 252 732V360A36 36 0 0 1 288 324Z"
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.25" />
        <path
            android:name="file"
            android:pathData="M404 244H572L656 328V452H368V280A36 36 0 0 1 404 244Z"
            android:fillColor="#FFFFFF" />
        <path
            android:name="fileGlow"
            android:pathData="M368 452H656V508A36 36 0 0 1 620 544H404A36 36 0 0 1 368 508Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="0"
                    android:startY="452"
                    android:endX="0"
                    android:endY="544">
                    <item android:offset="0" android:color="#66FFFFFF" />
                    <item android:offset="1" android:color="#00FFFFFF" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:name="front"
            android:pathData="M300 452H724A48 48 0 0 1 772 500V732A48 48 0 0 1 724 780H300A48 48 0 0 1 252 732V500A48 48 0 0 1 300 452Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="0"
                    android:startY="452"
                    android:endX="0"
                    android:endY="780">
                    <item android:offset="0" android:color="#6BFFFFFF" />
                    <item android:offset="1" android:color="#38FFFFFF" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
