<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <!-- WinAppSDK 1.7 supports back to 1809; nothing here needs a newer floor. -->
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Wooosh</RootNamespace>
    <AssemblyName>Send</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Send.ico</ApplicationIcon>
    <!-- WinUI 3 has no AnyCPU: the Windows App SDK ships per-architecture native bits. -->
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' != '' and '$(Platform)' != 'AnyCPU'">win-$(Platform.ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: one Send.exe with .NET, the Windows App SDK and the core inside,
         nothing to install first. MSIX tooling stays on because it generates the PRI
         the localized strings and compiled XAML load from. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Native DLLs and the PRI cannot run from inside the bundle; they extract to a
         per-user cache on first launch, beside the managed code that looks for them. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Partial trims only assemblies marked trimmable (the BCL and the Windows SDK
         projection, most of the size); Send's own code and its XAML stay whole. Trimming
         turns off reflection JSON and built-in COM interop, so neither may be used. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <SatelliteResourceLanguages>en;ja;ko;zh-Hans;zh-Hant;de;es;fr;it;nl;pt-BR;pl;ru;sv</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <!-- Program.cs owns Main so a second launch can hand over before creating a window. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- [LibraryImport] in Core/Interop and Platform emits unsafe P/Invoke stubs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4188" />
    <!-- DPAPI (Platform/DpapiKeyStore.cs) is not in the shared framework on .NET 8. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Strings/<locale>/Resources.resw is picked up by the default PRIResource glob that
    Microsoft.WindowsAppSDK enables. Listing them explicitly here as well produces
    duplicate-item errors, so do not add <PRIResource> entries unless the default
    globbing is first disabled with <EnableDefaultPRIResourceItems>false.
  -->

  <!--
    The self-contained Windows App SDK copies WinUI's own control text (*.mui) for 86
    cultures, outside SatelliteResourceLanguages. Keep the cultures that match Send's 14
    languages; any other system language falls back to English, as Send's own text does.
  -->
  <PropertyGroup>
    <_SendMuiCultures>;en-us;en-gb;de-de;es-es;es-mx;fr-fr;fr-ca;it-it;ja-jp;ko-kr;nl-nl;pl-pl;pt-br;ru-ru;sv-se;zh-cn;zh-tw;</_SendMuiCultures>
  </PropertyGroup>
  <Target Name="RemoveUnusedWindowsAppSDKCultures" AfterTargets="AddMicrosoftWindowsAppSDKPayloadFiles">
    <ItemGroup>
      <_SendMui Include="@(None)" Condition="'%(None.Extension)' == '.mui'" />
      <_SendMuiByCulture Include="@(_SendMui)">
        <Culture>$([System.IO.Path]::GetDirectoryName('%(_SendMui.Link)').ToLowerInvariant())</Culture>
      </_SendMuiByCulture>
      <_SendUnusedMui Include="@(_SendMuiByCulture)" Condition="!$(_SendMuiCultures.Contains(';%(_SendMuiByCulture.Culture);'))" />
      <None Remove="@(_SendUnusedMui)" />
    </ItemGroup>
    <Message Importance="high" Text="Removed @(_SendUnusedMui->Count()) of @(_SendMui->Count()) Windows App SDK .mui files." />
  </Target>

  <!--
    wooosh_core.dll (the Rust core, built for the same architecture) is loaded by
    Core/Interop/NativeMethods.cs. It is not committed: CI builds it into
    Native\<Platform>\ (.github/workflows/windows.yml); see Windows/README.md
    for building it by hand.
  -->
  <ItemGroup Condition="Exists('Native\$(Platform)\wooosh_core.dll')">
    <Content Include="Native\$(Platform)\wooosh_core.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>wooosh_core.dll</Link>
    </Content>
  </ItemGroup>

</Project>
